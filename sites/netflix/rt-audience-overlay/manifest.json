{
  "manifest_version": 3,
  "name": "Netflix Rotten Tomatoes Audience Overlay",
  "version": "0.1.0",
  "description": "Shows Rotten Tomatoes audience score overlays on Netflix artwork cards.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://www.rottentomatoes.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
